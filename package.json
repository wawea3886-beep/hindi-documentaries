{
  "name": "daily-hindi-documentaries",
  "version": "2.0.0",
  "private": true,
  "description": "A researched Hindi documentary (25-30 min) + 3 Shorts every day — automatic YouTube uploads with SEO, plus a website.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "daily": "node scripts/daily.js",
    "script": "node scripts/write-episode.js",
    "long": "node scripts/make-long-video.js",
    "shorts": "node scripts/make-shorts.js",
    "upload": "node scripts/upload-youtube.js",
    "build": "node scripts/build-site.js",
    "preview": "node scripts/preview.js",
    "youtube:auth": "node scripts/get-youtube-token.js",
    "youtube:save": "node scripts/get-youtube-token.js --save",
    "demo": "node scripts/daily.js --mock",
    "redo": "node scripts/redo-video.js"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "dotenv": "^18.0.4",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "googleapis": "^182.0.0",
    "msedge-tts": "^2.0.8"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "msedge-tts": false
  }
}
