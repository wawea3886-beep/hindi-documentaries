# Copy this file to .env for local runs. In the cloud, add the same names in
# GitHub → Settings → Secrets and variables → Actions (keys = Secrets, the rest = Variables).

# --- Website ---
SITE_NAME=Sach Ki Kahani
SITE_URL=https://YOUR-GITHUB-NAME.github.io/YOUR-REPO-NAME
YOUTUBE_CHANNEL_URL=https://www.youtube.com/@YourChannel

# --- Research + script: Google Gemini (free) — https://aistudio.google.com/apikey ---
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# --- Pictures (free). Without these, only real Wikipedia photos + title cards are used. ---
# Cloudflare Workers AI: https://dash.cloudflare.com → AI → Workers AI → "Use REST API"
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Backup provider (free key): https://enter.pollinations.ai
POLLINATIONS_API_KEY=

# --- Real stock video clips (free): https://www.pexels.com/api/ → "Get started" ---
PEXELS_API_KEY=

# --- YouTube (see README step 3) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# Optional playlists (IDs start with PL...)
YOUTUBE_PLAYLIST_ID=
YOUTUBE_SHORTS_PLAYLIST_ID=

# --- Optional tuning ---
# VOICE=ur-PK-AsadNeural            (female: ur-PK-UzmaNeural)
# SPEECH_RATE=+0%
# TARGET_WORDS=3900                 (≈ 27 minutes of narration)
# LONG_PUBLISH_UTC=13:00            (6:30 PM India)
# SHORTS_PUBLISH_UTC=14:30,27:30,31:30   (hours ≥ 24 = next day)
